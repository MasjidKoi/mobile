# Copy to `.env.local` (gitignored) and adjust per machine.

# Backend base URL. Routers mount at ROOT — there is NO /api/v1 prefix.
# - Simulator/emulator: http://localhost:8001
# - Physical device:    http://<your-LAN-IP>:8001  (or an Expo tunnel URL)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8001

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Google Maps Android key — required ONLY once map screens land (Phase 3).
# Set it on `android.config.googleMaps.apiKey` in app config when you wire maps.
# EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
