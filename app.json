{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "masjidkoi",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "extra": {
      "apiBaseUrl": "https://api.masjidkoi.me",
      "appEnv": "development"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.mobile"
    },
    "android": {
      "package": "com.anonymous.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0E6B4F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-badge.png",
          "imageWidth": 190,
          "resizeMode": "contain",
          "backgroundColor": "#0E6B4F",
          "dark": {
            "image": "./assets/images/splash-badge.png",
            "imageWidth": 190,
            "backgroundColor": "#0A523D"
          }
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MasjidKoi uses your location to find nearby masjids, show prayer times, and point you toward the Qibla."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/azan_mecca.wav",
            "./assets/sounds/azan_madina.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MasjidKoi uses your photos so you can attach a picture when you submit a masjid."
        }
      ],
      "expo-audio",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
